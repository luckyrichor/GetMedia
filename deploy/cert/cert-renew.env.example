# 安装位置：/etc/getmedia/cert-renew.env  （root:root 600；不含任何密钥，只是路径与阈值）
# 由 getmedia-cert-renew.sh 以 shell 方式读取：KEY=value，值里不要有空格、引号或 $。

# 证书文件：443 块里 ssl_certificate 指向的同一个文件（与 GETMEDIA_CERT_PATH 相同）
CERT_FILE=/etc/ssl/PLACEHOLDER/fullchain.pem

# certbot 里这张证书的名字（certbot certificates 可查）
CERT_NAME=PLACEHOLDER

# 剩余有效期低于该小时数才续期。证书总寿命约 160 小时（6 天 16 小时）。
RENEW_BEFORE_HOURS=56

# 可选覆盖
#CERTBOT_BIN=/usr/bin/certbot
#ADMIN_BIN=/usr/local/sbin/getmedia-admin
