# 安装位置：/etc/getmedia/llm.env    （属主 root:root，权限 600）
# 用途：Agent 的模型服务（火山方舟 Ark，OpenAI 兼容）。**本文件为空时，Agent 走确定性规则，
# 不产生任何外部请求**，所以留空是安全状态，不是故障。
#
# 现状（2026-11-16 已定）：Agent 采用方案 B（模型 + 动作闭环），供应商为火山方舟 Ark，
# 每账号每日上限 200 次。代码尚未实施；实施后本文件为空 = 纯规则应答。
# 变量清单与说明见 docs/agent-model-plan.md §5。
#
# 安全约束：
#   * 只放服务器，不进 Git、不进客户端、不贴聊天、不写进日志；
#   * 不放在 getmedia.env 里，是为了单独备份、单独收紧权限、单独轮换（改这个文件 → 重启 API）；
#   * 应用只读环境变量，不把密钥写进数据库、响应或错误信息。
#
# 生成/填写步骤（在服务器上执行）：
#   sudo install -d -m 0750 -o root -g getmedia /etc/getmedia
#   sudo install -m 600 -o root -g root /dev/null /etc/getmedia/llm.env
#   sudoedit /etc/getmedia/llm.env        # 粘贴下面的键，填真实值
#   sudo systemctl restart getmedia-api
#
# 校验（只数键，不打印值）。systemctl show -p Environment 看不到 EnvironmentFile 的变量，
# 必须读进程环境：
#   sudo tr '\0' '\n' < /proc/$(systemctl show -p MainPID --value getmedia-api)/environ \
#     | grep -c '^GETMEDIA_LLM_API_KEY='      # 输出 1 = 已加载

# 必填（接模型时）：服务端密钥。
GETMEDIA_LLM_API_KEY=CHANGE_ME

# 可选：接口地址。默认就是火山方舟北京区；换供应商时改这里（需保持 /chat/completions 形状）。
GETMEDIA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 必填（与 Key 一起）：模型名或推理接入点 ID，按顺序 fallback。与旧音频/视频项目的 ARK_MODELS 同名同序；
# 缺 Key 或缺这一项都视为未配置，Agent 走纯规则应答，不发外网请求。
GETMEDIA_LLM_MODELS=<模型1>,<模型2>

# 可选：单次调用超时（秒）与最大输出 token。
GETMEDIA_LLM_TIMEOUT=35
GETMEDIA_LLM_MAX_TOKENS=700

# 可选：每账号每日调用上限（超出后回落规则应答，并在回复里说明）。
GETMEDIA_LLM_DAILY_CAP=200
