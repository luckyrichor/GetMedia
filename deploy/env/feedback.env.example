# 安装位置：/etc/getmedia/feedback.env  （属主 root:root，权限 600）
# 需要另建一份，不复用 GetAudio 的。七个变量缺任何一个，服务就只落库、不发邮件（反馈库才是权威记录）。
# 真实收件邮箱与授权码只放服务器上这个文件，不进仓库；这里全是占位值。
# 邮箱的格式示意：owner@example.invalid（保留域名，仅作示例）
FEEDBACK_MAIL_TO=CHANGE_ME
FEEDBACK_MAIL_FROM=CHANGE_ME
FEEDBACK_SMTP_HOST=smtp.example.invalid
FEEDBACK_SMTP_PORT=465
# ssl（隐式 TLS，常见端口 465）或 starttls（常见端口 587）
FEEDBACK_SMTP_SECURITY=ssl
FEEDBACK_SMTP_USER=CHANGE_ME
FEEDBACK_SMTP_PASSWORD=CHANGE_ME
