# 安装位置：/etc/getmedia/getmedia.env  （属主 root:root，权限 600）
# systemd EnvironmentFile 格式：KEY=value，不加引号、不写 export。
# 仓库里只有占位值；真实值只在服务器上填。

# 必填，至少 32 个字符。生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 它用于恢复码与邀请码的 HMAC：丢失或更换后，所有尚未使用的恢复码和邀请码都会失效。
# 请单独离线备份（不要和数据库快照放在一起）。占位值过短，原样拷贝会导致服务拒绝启动。
GETMEDIA_SECRET_KEY=CHANGE_ME

GETMEDIA_DATA_DIR=/var/lib/getmedia
GETMEDIA_DATABASE_URL=sqlite:////var/lib/getmedia/getmedia.db
GETMEDIA_BACKUP_DIR=/var/lib/getmedia/snapshots
GETMEDIA_FEEDBACK_IMAGE_DIR=/var/lib/getmedia/feedback-images

# 删除台账：放在数据目录之外（快照目录里没有它），恢复时用来重放删除，已注销账号不会复活。
GETMEDIA_LEDGER_PATH=/var/lib/getmedia-ledger/deletion-ledger.log

# 协议文本与发布信息：改文件即生效，无需重新构建。协议改版必须同时改版本号。
GETMEDIA_LEGAL_DIR=/etc/getmedia/legal
GETMEDIA_RELEASE_FILE=/etc/getmedia/release.json

# runtime.json（注册开关、邀请码开关、维护提示）会被管理 CLI 原子改写（同目录写临时文件再替换），
# 所以不能放在 root 只读的 /etc/getmedia 里，放在服务数据目录。
GETMEDIA_RUNTIME_FILE=/var/lib/getmedia/runtime.json

# 须与 getmedia-api.service 的 --host/--port、nginx 的 proxy_pass 一致。
GETMEDIA_BIND=127.0.0.1:8700

# 证书文件（只读，用于"剩余有效期 <24 小时"告警）。填 443 块里 ssl_certificate 指向的同一个文件。
GETMEDIA_CERT_PATH=/etc/ssl/PLACEHOLDER/fullchain.pem

# 磁盘水位告警检查的路径（默认数据目录）。
GETMEDIA_DISK_PATH=/var/lib/getmedia

# 可选：Argon2id 参数（默认 65536 KiB、3 次迭代，沙箱实测单次约 130 ms）。
# 在服务器规格上复测后，调到单次约 100–200 ms 再取消注释；参数写入哈希串，已有账号的哈希不受影响。
#GETMEDIA_ARGON_MEMORY_KIB=65536
#GETMEDIA_ARGON_ITERATIONS=3
