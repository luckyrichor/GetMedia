{
  "name": "getmedia-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GetMedia 网页端（任务一只有 public-app；shared 不得引用 owner 代码）",
  "scripts": {
    "dev": "vite --config public-app/vite.config.ts",
    "build": "tsc --noEmit && vite build --config public-app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
