{
  "name": "getmedia-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GetMedia 网页端：public-app（公开页）与 owner-app（管理台），共享 shared/ 的类型与无副作用工具",
  "scripts": {
    "dev": "vite --config public-app/vite.config.ts",
    "dev:owner": "vite --config owner-app/vite.config.ts",
    "build": "npm run build:public && npm run build:owner",
    "build:public": "tsc --noEmit && vite build --config public-app/vite.config.ts",
    "build:owner": "tsc --noEmit && vite build --config owner-app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs public-app && node scripts/size.mjs owner-app",
    "size:public": "node scripts/size.mjs public-app",
    "size:owner": "node scripts/size.mjs owner-app"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
